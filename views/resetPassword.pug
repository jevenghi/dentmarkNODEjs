extends base

block styles
  link(rel="stylesheet" href="/css/signup.css")

block content
  block header
  div.container
    form.reset-form
      h2(data-key="setNewPassword")
      .form-group
        label(for="password-reset" data-key="newPassword")
        input(type="password", id="password-reset", name="password-reset", required)
      .form-group
        label(for="passwordConfirm-reset" data-key="confirmNewPassword")
        input(type="password", id="passwordConfirm-reset", name="passwordConfirm-reset", required)
      button(type="submit" data-key="continue")
