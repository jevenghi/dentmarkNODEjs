extends base

block styles
  link(rel="stylesheet" href="/css/signup.css")

block content
  block header
  .container
    form.forgot-pass-form
      h2(data-key="resetPassword")
      p(data-key="forgotPasswordInstructions")
      .form-group
        label(for="email-forgot-pass") E-mail
        input(type="email", id="email-forgot-pass", name="email-forgot-pass", required)
      button(type="submit", id="forgot-pass" data-key="continue")
