extends base

block styles 
  link(rel="stylesheet" href="/css/landing.css")
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
  link(href='https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap' rel='stylesheet')


block content
  block header
  -
    const landingText = {
      en: {
        languageLabel: 'Language',
        title: 'Welcome to DentMarker!',
        intro: 'Looking for accurate cost and time estimates for dent repair? Want to keep track of all your dent repair tasks while ensuring our technicians plan with precision and efficiency? Sign up now to start using our app. Upload the photos and pinpoint the dents. We will receive your request instantly for accurate evaluation. Save your time and hassle!',
        login: 'Login',
        signup: 'Sign Up',
        guest: 'Use as guest'
      },
      nl: {
        languageLabel: 'Taal',
        title: 'Welkom bij DentMarker!',
        intro: 'Op zoek naar nauwkeurige kosten- en tijdsinschattingen voor de reparatie van deuken? Wil je al je reparatieopdrachten bijhouden en zorgen dat onze technici precies en efficient kunnen plannen? Meld je nu aan om onze app te gebruiken. Upload de fotos en markeer de deuken. Wij ontvangen je aanvraag direct voor een nauwkeurige beoordeling. Bespaar tijd en gedoe!',
        login: 'Inloggen',
        signup: 'Aanmelden',
        guest: 'Gebruik als gast'
      }
    };
    const currentLanguage =
      typeof language !== 'undefined' && language === 'en' ? 'en' : 'nl';
    const text = landingText[currentLanguage];
  .container
    .login-form
      .language-switcher(aria-label=text.languageLabel)
        a.language-link(href="/landing?lang=en" class=currentLanguage === 'en' ? 'language-link--active' : '' lang="en" aria-current=currentLanguage === 'en' ? 'true' : false) EN
        a.language-link(href="/landing?lang=nl" class=currentLanguage === 'nl' ? 'language-link--active' : '' lang="nl" aria-current=currentLanguage === 'nl' ? 'true' : false) NL
      h1= text.title
      p= text.intro
      .actions
        a.btn(href="/login")= text.login
        a.btn.signup_btn(href="/signup")= text.signup
        a.btn.guest_btn(href="/guest")= text.guest
