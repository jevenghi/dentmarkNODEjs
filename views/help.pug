extends base

block styles
  link(rel="stylesheet" href="/css/style.css")

block content

  .container
    h1 How to use:
    div.how_to(class="left-align")
      
      ol
        li Choose vehicle type.
        li Select the side or upload your photo.
        li Choose shape, length and also orientation if the dent is elongated. If dent comes with paint damage, tick that option. 
        li Mark the dents. If vehicle suffered from hail damage and has multiple amount of dents, you don't have to mark every dent, just tick "Hail damage" option and upload the photos.
        li Enter vehicle model and press "Send". You will be notified if task was succesfully sent. You can now find it in "My tasks". If you have any questions or issues using the app please let us know at info@am-place.nl
    a.btn(href="/main") Back to main page