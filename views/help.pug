extends base

block styles
  link(rel="stylesheet" href="/css/style.css")

block content
  -
    const currentLanguage =
      typeof language !== 'undefined' && language === 'en' ? 'en' : 'nl';
    const helpText = {
      en: {
        languageLabel: 'Language',
        contact: 'If you are experiencing some issues with the app or have a question which is not covered in "How-to" below, please contact us at:',
        title: 'How to send a new task:',
        steps: [
          'Upload photos (up to 10).',
          'Select uploaded photo.',
          'Default marker is used for dents shorter than 5 cm and without paint damage. If dent exceeds 5 cm or comes with paint damage, tick that option(s) accordingly.',
          'Mark the dents. If the vehicle suffered extreme damage, like a deep all-side long dent or hail damage with many dents, you do not have to mark every dent. Tick "Special case" and provide a short description in the "Additional notes" field.',
          'Enter vehicle model and year or NL license plate number, optionally add remarks, and press "Send Task". You will be notified if the task was sent successfully. You can now find it in "My tasks".'
        ]
      },
      nl: {
        languageLabel: 'Taal',
        contact: 'Als je problemen ondervindt met de app of een vraag hebt die niet wordt behandeld in de onderstaande handleiding, neem dan contact met ons op via:',
        title: 'Een opdracht verzenden:',
        steps: [
          'Upload fotos (maximaal 10).',
          'Selecteer de geuploade foto.',
          'De standaardmarkering wordt gebruikt voor deuken korter dan 5 cm en zonder lakschade. Als de deuk groter is dan 5 cm of er lakschade is, vink dan die optie(s) aan.',
          'Markeer de deuken. Als het voertuig extreme schade heeft opgelopen, zoals een lange, diepe deuk of hagelschade met meerdere deuken, hoef je niet elke deuk te markeren. Vink "Speciaal geval" aan en geef een korte beschrijving in het veld "Aanvullende opmerkingen".',
          'Voer het model en bouwjaar van het voertuig in of het kenteken, voeg eventueel aanvullende opmerkingen toe en druk op "Taak verzenden". Je krijgt een melding als de opdracht succesvol is verzonden. Je kunt deze daarna vinden in "Mijn taken".'
        ]
      }
    };
    const text = helpText[currentLanguage];

  .main-container
    .language-switcher.main-language-switcher(aria-label=text.languageLabel)
      a.language-link.help-language-link(href="/help?lang=en" class=currentLanguage === 'en' ? 'language-link--active' : '' lang="en" aria-current=currentLanguage === 'en' ? 'true' : false) EN
      a.language-link.help-language-link(href="/help?lang=nl" class=currentLanguage === 'nl' ? 'language-link--active' : '' lang="nl" aria-current=currentLanguage === 'nl' ? 'true' : false) NL
    .help-container
      .contact-container
      | #{text.contact} 
      a(href="mailto:info@am-place.com") info@am-place.com
      h3= text.title
      .how_to.left-align
        ol
          each step in text.steps
            li= step
  .overlay.hidden
