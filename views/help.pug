extends base

block styles
  link(rel="stylesheet" href="/css/style.css")

block content

  .main-container
    .help-container
      .contact-container If you are experiencing some issues with the app or have a question which is not covered in "How-to" below, please contact us at info@am-place.com
      a(href="info@am-place.com")
      h3 How to use:
      div.how_to(class="left-align")
        
        ol
          li Upload photos (up to 10). 
          li Select uploaded photo.
          li Default marker is used for dents shorter than 5 cm and without paint damage. If dent exceeds 5 cm or comes with paint damage, tick that option/options accordingly. 
          li Mark the dents. If vehicle suffered from extreme damage, like deep all-side long dent, or hail damage and has multiple amount of dents, you don't have to mark every dent, just tick "Special case" option and provide short description in the "Additional notes" field.
          li Enter vehicle model, year (additional remarks optionally) and press "Send Task". You will be notified if task was successfully sent. You can now find it in "My tasks". 