//- extends base
//- block styles
//-   link(rel="stylesheet" href="/css/style.css")
html
  head
    style(type='text/css').
      body {
        font-family: Arial, sans-serif;
        font-size: 1rem;
        margin-left: 3rem;
        margin-right: 3rem;
        margin-top: 5rem;
        margin-top: 5rem;
      }
      .main-container {
        margin-top: 2rem; /* Adjust as needed */
      }
      .task-table {
        width: 100%; /* Ensure table fills the width */
        border-collapse: collapse; /* Collapse borders */
      }
      .task-table th,
      .task-table td {
        padding: 0.5rem; /* Add padding to table cells */
        border: 1px solid black; /* Add borders to cells */
      }
  body
    -
      const reportLanguage =
        typeof language !== 'undefined' && language === 'nl' ? 'nl' : 'en';
      const reportText = {
        en: {
          date: 'Date',
          customer: 'Customer',
          vehicleModel: 'Vehicle Model',
          taskStatus: 'Status',
          taskCost: 'Cost',
          total: 'Total:',
          statuses: {
            open: 'Open',
            'in-progress': 'In Progress',
            pending: 'Complete/Not paid',
            complete: 'Paid',
          },
        },
        nl: {
          date: 'Datum',
          customer: 'Klant',
          vehicleModel: 'Voertuig',
          taskStatus: 'Status',
          taskCost: 'Kosten',
          total: 'Totaal:',
          statuses: {
            open: 'Open',
            'in-progress': 'In uitvoering',
            pending: 'Voltooid/Niet betaald',
            complete: 'Betaald',
          },
        },
      }[reportLanguage];
    .main-container 
      table.task-table
        thead
          tr
            th= reportText.date
            th= reportText.customer
            th= reportText.vehicleModel
            th= reportText.taskStatus
            th= reportText.taskCost
        tbody
          each task in tasks
            tr
              td= new Date(task.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
              td= task.user.name
              td= task.carModel
              td= reportText.statuses[task.taskStatus] || task.taskStatus
              td= task.totalCost
        tfoot
          tr
            td(colspan="4")= reportText.total
            td
              strong= totalCostAggregate[0].totalCost    
