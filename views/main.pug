extends base
include mixins.pug

block styles
  link(rel="stylesheet" href="/css/style.css")
  link(href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz@9..40&family=Tourney:wght@100&display=swap&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet")
  link(href='https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap' rel='stylesheet')
    

block content
  -
    const currentLanguage =
      typeof language !== 'undefined' && language === 'nl' ? 'nl' : 'en';
    const languageLabel = currentLanguage === 'nl' ? 'Taal' : 'Language';
  .main-container
    if (role === 'guest')
      .language-switcher.main-language-switcher(aria-label=languageLabel)
        a.language-link(href="/guest?lang=en" class=currentLanguage === 'en' ? 'language-link--active' : '' lang="en" aria-current=currentLanguage === 'en' ? 'true' : false) English
        a.language-link(href="/guest?lang=nl" class=currentLanguage === 'nl' ? 'language-link--active' : '' lang="nl" aria-current=currentLanguage === 'nl' ? 'true' : false) Nederlands
    h1(data-key="welcome")
    h2(data-key="choosePhotos")
    .photo-upload_container

      //- h2 Please choose photos to upload:
      input.form__upload(type="file" accept="image/*" id="photo" name="photo" multiple)
      .spinner(id="spinner")
      //- label(class="choose-photo-btn" for="photo") Browse photos
      //- button.form__btn.upload_photo Upload
    .logo-container
      img#logoImage(src="/pics/amlogo.png")
    //- .need-help-link
    //-   a(href="/help" data-key="needHelp")
    
    .choose.choose__side.hidden
      h2(data-key="chooseSide")
    .sides-container  
    .sentinel
    +markerContainer()
    .marker-container-placeholder
      
    //- .marker-container.hidden
    //-   .row
    //-     label
    //-       div(data-key="paintDamaged")
    //-       input.m_checkbox.m_checkbox--paint(type="checkbox" id="paint-damaged")
    //-     label
    //-       | 5+ cm
    //-       input.m_checkbox.m_checkbox--hail(type="checkbox" id="big-dent")
    //-     label
    //-       div(data-key="specialCase")
    //-       input.m_checkbox.m_checkbox--hail(type="checkbox" id="special-case")
    //-   .row    
    //-     .remove-container
    //-       button.remove_mark_btn.remove__last Clear Last Mark
    //-       button.remove_mark_btn.remove__photo Delete Image
    //-       button.remove_mark_btn.remove--marks Clear All Marks

    .image-container
      img#vehicleImage(src="")
      div#marker
    //- .logo-container
    //-   img#logoImage(src="/pics/amlogo.png")  

    //- .remove-container.hidden
    //-   button.remove_mark_btn.remove__last Undo
    //-   button.remove_mark_btn.remove__photo Delete Image
    //-   button.remove_mark_btn.remove--marks Clear All Marks
    
    //- if (role === 'admin')
    //-   .search-bar.hidden
    //-     input(type="text" placeholder="Customer name..." id="search-input")
    //-     div#search-results.dropdown-content

    .send-container.hidden
      if (role === 'admin')
        .search-bar.hidden
          input(type="text" placeholder="Customer name..." id="search-input" class="form__input--customer")
          div#search-results.dropdown-content
      if (role === 'guest')
        .guest-email
          input.form__input.form__input--guest-email(type="email" placeholder="Email address..." autocomplete="email" aria-describedby="guest-email-warning")
          p#guest-email-warning.guest-email-warning.hidden(data-key="enterValidEmail" aria-live="polite") Please enter a valid e-mail address
      .vehicle-model
        input.form__input.form__input--model(type="text" placeholder="Vehicle model...")
        //- label.form__label Year
        select#year(name="year")
          option(value="" data-key="year")
          each year in Array.from({ length: new Date().getFullYear() - 2000 }, (_, index) => new Date().getFullYear() - index)
            option(value=year)= year
          option(value="older" data-key="older")
      .vehicle-lookup-divider(data-key="or")
      input.form__input.form__input--kenteken(type="text" placeholder=currentLanguage === 'nl' ? 'Kenteken...' : 'License plate...' autocomplete="off" inputmode="text")
      input.form__input.form__input--note(type="text" placeholder="Additional notes...")
    
          
    .form__row.form__row--button
      button.form__btn.send-marks.hidden(data-key="sendTask")
    .need-help-link
      a(href="/help" data-key="needHelp")

  .overlay.hidden
