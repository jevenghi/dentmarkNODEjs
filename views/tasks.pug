extends base
block styles
  link(rel="stylesheet" href="/css/style.css")
block content
  .main-container
    .filter-menu
        //- .sort-by Sort by:  
        //-   select#sort-by
        //-     option(value='createdAt') Created
        //-     option(value='completedAt') Completed
        .filter-date
          label(for='from-date' data-key='from')
          input(type='date', id='from-date', value=from)
          label(for='to-date' data-key='to')
          input(type='date', id='to-date', value=to)
          button(class='reset-date' data-key='reset')
        .filter-status
          span(data-key='status')
          select#status-filter
            option(value='', selected=taskStatus === '', data-key='all') All
            option(value='open', selected=taskStatus === "open", data-key='open') Open
            option(value='in-progress', selected=taskStatus === 'in-progress', data-key='inProgress') In Progress
            option(value='pending', selected=taskStatus === "pending", data-key='notPaid') Complete/Not paid
            option(value='complete', selected=taskStatus === "complete", data-key='paid') Paid
          //- button.download-report Download Summary
          .download-options
            button(class='download-report' id='download-report' data-key='downloadSummary') 
            .format-dropdown
              button.format-option(data-format="pdf") PDF
              button.format-option(data-format="excel") Excel
        .filter-word
          input(type='text', id='search-word', placeholder='Search in Vehicle Model' data-placeholder-key='searchInModel')
          button(class='search-by-word' data-key='search')
          button(class='reset-search' data-key='reset')
        - if (role === 'admin')
          .change-status-bulk.hidden
            span(data-key='status')
            select#change-status-bulk
              option(value='open' data-key='open') Open
              option(value='in-progress' data-key='inProgress') In Progress
              option(value='pending' data-key='notPaid') Complete/Not paid
              option(value='complete' data-key='paid') Paid
            button.change-status-bulk-btn(data-key='change')
            //- button.create-invoice-btn Invoice
          


    - if (role === 'user')
      table.task-table
        thead
          tr
            th(data-key='vehicleModel')
            th(data-key='taskStatus')
            th(data-key='taskCost')
            th(data-key='taskCreated')
            th(data-key='taskCompleted')
        tbody
          //- if tasks.length === 0
          //-   tr
          //-     td(colspan='4') No tasks found
          each task in tasks
            tr
              td: a(href=`/tasks/${task._id}` class='table-link')= task.carModel
              td(data-status=task.taskStatus)= task.taskStatus
              td= `€ ${task.totalCost}`
              td= new Date(task.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
              td
                if task.completedAt
                  = new Date(task.completedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
    - if (role === 'admin') 
      //- .search-bar
      //-   input(type='text', placeholder='Search customer...', id='search-input')

      table.task-table
        thead
          tr
            th(data-key='customer')
            th(data-key='vehicleModel')
            th(data-key='taskStatus')
            th(data-key='taskCost')
            th(data-key='taskCreated')
            th(data-key='taskCompleted')
        tbody
          if tasks.length === 0
            tr
              td(colspan='6' data-key='noTasksFound')
          each task in tasks
            tr
              //- td: a(href=`/users/${task.user.id}` class='table-link')= task.user.name
              td: a(href=`/tasks?user=${task.user.id}` class='table-link')= he.decode(task.user.name)
              td: a(href=`/tasks/${task._id}` class='table-link')= task.carModel
              td(class='clickable-status' id=task._id data-status=task.taskStatus)= task.taskStatus
              td= task.totalCost
              td= new Date(task.createdAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
              td
                if task.completedAt
                  = new Date(task.completedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
    div.pagination-buttons
      if page > 1
        button.previous-button(data-key='previous')
      //- if page < totalPageCount
      //-   button.next-button() Next
      if tasks.length === limit
        button.next-button(data-key='next')
    //- button.download-report Download Report

     
  .overlay.hidden            


