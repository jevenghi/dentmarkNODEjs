extends base
include mixins.pug

block styles
  link(rel="stylesheet" href="/css/style.css")
  link(href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz@9..40&family=Tourney:wght@100&display=swap&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet")
block content
  .main-container
    if role === 'admin'  
      button.delete-task(data-task-id=taskId) Delete Task
    .task-header(data-task-id=taskId)
      if role === 'admin'
        p Customer: #{customer}
      p Model: #{model}
      p Task created: #{date}
      //- button.add-dents(data-task-id=taskId) Add dents
              if role === 'admin'
              if role === 'admin'
      if role === 'admin'
        .task-status-wrapper
            p Task status:  
            select.task-status-select(data-task-id=taskId)
              option(value="open", selected=taskStatus === "open") Open
              option(value="in-progress", selected=taskStatus === "in-progress") In Progress
              option(value="pending", selected=taskStatus === "pending") Complete/Not paid
              option(value="complete", selected=taskStatus === "complete") Paid

        .task-cost-wrapper
          p Total cost:
          input(type="text", placeholder=`€${totalCost}`, class="total-cost", data-task-id=taskId)
            
        .task-cost-wrapper
          p Notes:
          //- input(type="text", value=remark, class="task-remark", data-task-id=taskId)
          textarea.task-remark(data-task-id=taskId)= remark

             
      if role === 'user'
        p Task status: #{taskStatus}
        p Total cost: € #{totalCost}
        p Notes: #{remark}
    if role === 'admin'    
      button(class='download-task-report', data-task-id=taskId) Download Task 
  
    

    //- if role === 'admin'
    .main-container
      .photo-upload_container
        input.form__upload(type="file" accept="image/*" id="photo" name="photo" multiple)
        //- label(class="choose-photo-btn" for="photo") Choose Photos

        button.form__btn.upload_photo Upload
  
      .choose.choose__side
        h2(data-key="chooseSide")
      .sentinel
      +markerContainer()
      .marker-container-placeholder
  
      //- .marker-container.hidden
      //-   .row
      //-     label
      //-       | Paint damaged
      //-       input.m_checkbox.m_checkbox--paint(type="checkbox" id="paint-damaged")
      //-     label
      //-       | 5+ cm
      //-       input.m_checkbox.m_checkbox--hail(type="checkbox" id="big-dent")
      //-     label
      //-       | Special case
      //-       input.m_checkbox.m_checkbox--hail(type="checkbox" id="special-case")
      //-   .row
      //-     .remove-container.hidden
      //-       button.remove_mark_btn.remove__last Clear last mark
      //-       button.remove_mark_btn.remove__photo Delete Image
      //-       button.remove_mark_btn.remove--marks Clear All Marks

      .image-container
        img#vehicleImage(src="")
        div#marker

      //- .remove-container.hidden
      //-   button.remove_mark_btn.remove__last Undo
      //-   button.remove_mark_btn.remove__photo Delete Image
      //-   button.remove_mark_btn.remove--marks Clear All Marks

    button(type="button" class='save-new-dents' data-key="saveChanges")
    button(type="button" class='back-tasks' data-key="backToTasks")           
  .overlay.hidden
            