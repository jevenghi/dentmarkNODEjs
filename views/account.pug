extends base

block styles
  link(rel="stylesheet" href="/css/style.css")
  

block content
  .main-container
    form.form-user-data
      h2(data-key="changeAccountSettings")

      div.form-group
        label(for="email" ) Email
        input(type="email" id="email" name="email" value=`${user.email}` required)
      div.form-group
        label(for="name" data-key="companyName")
        input(type="text" id="name" name="name" value=`${he.decode(user.name)}` required)
      div.form-group
        label(for="language" data-key="language")
        select#language(name="language")
          option(value="en" selected=user.language === "en") English
          option(value="nl" selected=user.language === "nl") Nederlands

      button(type="submit" data-key="saveChanges") 

    form.form-user-password
      h2(data-key="changePassword")
      
      div.form-group
        label(for="oldPassword" data-key="currentPassword")
        input(type="password" id="oldPassword" name="oldPassword" required)
      div.form-group
        label(for="newPassword" data-key="newPassword")
        input(type="password" id="newPassword" name="newPassword" required)
      div.form-group
        label(for="confirmNewPassword" data-key="confirmNewPassword")
        input(type="password" id="confirmNewPassword" name="confirmNewPassword" required)
      button(type="submit" data-key="changePasswordButton")
  .overlay.hidden
    