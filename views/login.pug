extends base

block styles
  link(rel="stylesheet" href="/css/signup.css")
  link(rel='preconnect' href='https://fonts.googleapis.com')
  link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
  link(href='https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap' rel='stylesheet')


block content
  block header
  .container
    form.login-form
      h2 Login
      .form-group
        label(for="email") E-mail
        input(type="email", id="email", name="email", required)
      .form-group
        label(for="password") Password
        input(type="password", id="password", name="password", required)
      button(type="submit", id="loginButton")
        span#loginText Login
        .spinner(id="spinner", style="display: none;") 
    .forgot-password
      a(href="/forgot-password") Forgot password?  