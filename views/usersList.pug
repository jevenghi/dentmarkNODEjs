extends base
block styles
  link(rel="stylesheet" href="/css/style.css")
block content
  header.header
    nav.nav.nav--user
      button.nav__el.nav__el--myacc
        img(src="user.png", alt="AccIcon")
  div.modal.hidden
    div.modal__content
      a.modal__link(href="/me" data-key="myProfile")
      a.modal__link(href="/" data-key="sendNewTask")
      a.modal__link(href="/tasks" data-key="myTasks")
      a.modal__link.logout(href="#" data-key="logOut")
  .main-container
    table.task-table
        thead
          tr
            th(data-key="customerName")
            th(data-key="tasksNumber")
            th(data-key="email")
            th(data-key="taskCreated")
        tbody
          each user in users
            tr
              td: a(href=`/users/${user.id}` class='table-link')= user.name
              td= user.tasks.length
              td= user.email
              td= user.createdAt.toLocaleDateString('en-GB')
